{
  "manifest_version": 3,
  "name": "TTHelper-SC — Community Edition",
  "description": "Built by a sailing scheduler, for sailing schedulers.",
  "version": "1.0.0",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost:3737/*",
    "https://www.tradetech.net/*"
  ],
  "action": {},
  "commands": {
    "highlight-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Highlight #1 (color set in the Highlighter settings panel)"
    },
    "highlight-2": {
      "description": "Highlight #2 (color set in the Highlighter settings panel)"
    },
    "highlight-3": {
      "description": "Highlight #3 (color set in the Highlighter settings panel)"
    },
    "highlight-4": {
      "description": "Highlight #4 (color set in the Highlighter settings panel)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tradetech.net/*",
        "https://mergeimagesonline.com/*"
      ],
      "js": [
        "src/utils/date.js",
        "src/utils/toolbar.js",
        "src/utils/draggable-panel.js",
        "src/utils/banner.js",
        "src/utils/update-flow.js",
        "src/utils/dom.js",
        "src/utils/voyage.js",
        "src/utils/vessel-row.js",
        "src/utils/port-row.js",
        "src/utils/custom-rules.js",
        "src/core/boundary.js",
        "src/features/notes.js",
        "src/features/notes-sidebar.js",
        "src/features/validation.js",
        "src/features/save-confirmation.js",
        "src/features/date-syncing.js",
        "src/features/manual-etd-highlight.js",
        "src/features/arrival-depart-order-check.js",
        "src/features/port-date-order-check.js",
        "src/features/insert-port.js",
        "src/features/port-name-reminder.js",
        "src/features/vessel-name-reminder.js",
        "src/features/port-highlighting.js",
        "src/features/awr-flag.js",
        "src/features/last-foreign-port-check.js",
        "src/features/duplicate-vessel.js",
        "src/features/duplicate-vessel-check.js",
        "src/features/fix-vessel-dates.js",
        "src/features/custom-rules-settings.js",
        "src/features/highlighter-settings.js",
        "src/features/vessel-no-date.js",
        "src/features/port-no-date.js",
        "src/features/vessel-to-be-announced.js",
        "src/features/voyage-direction.js",
        "src/features/resize-toggle.js",
        "src/features/schedule-cascade.js",
        "src/features/vessel-recommendation.js",
        "src/features/rearrange-vessels.js",
        "src/features/keyboard-navigation.js",
        "src/features/select-field-on-focus.js",
        "src/features/auto-nav-schedules.js",
        "src/features/date-step-buttons.js",
        "src/features/voyage-step-buttons.js",
        "src/features/date-calculator.js",
        "src/features/live-check.js",
        "src/main.js",
        "src/features/update-extension-native.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.tradetech.net/*"
      ],
      "js": [
        "src/features/force-tab-links.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/features/highlighter.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
